# ─── Scholario Ops — server configuration ────────────────────────────────────
# Copy to .env and fill in. Only ADMIN_EMAIL / ADMIN_PASSWORD are needed to start;
# everything else enables an integration.

# Server
PORT=3000
HOST=0.0.0.0
# Public address of this Ops server. Used in the agent install command and in
# notification links — your VPS servers must be able to reach it.
PUBLIC_URL=https://ops.example.com
# PostgreSQL — the single source of truth for configuration and operational data.
# Tables are created automatically (migrations in server/migrations) inside DB_SCHEMA.
DATABASE_URL=postgresql://user:password@localhost:5432/scholario_ops
DB_SCHEMA=ops
# Holds only the generated session secret (.jwt-secret) when JWT_SECRET is empty.
DATA_DIR=./data
# Extra browser origins allowed to call the API (comma separated). Leave empty when
# the dashboard is served by this server.
CORS_ORIGINS=
# Express "trust proxy" setting; use "loopback" behind nginx on the same host.
TRUST_PROXY=loopback

# First administrator (created only when no users exist yet)
ADMIN_EMAIL=admin@example.com
# At least 10 characters with upper-case, lower-case and a number.
# If empty/weak, a random password is generated and printed in the server log.
ADMIN_PASSWORD=
ADMIN_NAME=System Administrator

# Session signing secret (≥32 chars). If empty, one is generated into DATA_DIR.
JWT_SECRET=
ACCESS_TOKEN_TTL_SEC=28800
REFRESH_TOKEN_TTL_SEC=604800

# ─── Cloudflare (Load Balancer health, zone/SSL/DNS visibility) ──────────────
# dash.cloudflare.com → My Profile → API Tokens → Create Token (custom). Read-only
# monitoring of ICT needs only:
#   Account → Load Balancing: Monitors and Pools → Read   (pools, pool health, RTT)
#   Zone    → Load Balancers → Read                         (routing / pool order)
#   Zone    → Zone → Read
# Optional: Zone → SSL and Certificates → Read, Zone → Analytics → Read.
# Zone → DNS → Edit is only needed for DNS-record failover of non-LB applications.
# The token stays on the server; the browser never sees it.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_SYNC_INTERVAL_SEC=300
CLOUDFLARE_LB_SYNC_INTERVAL_SEC=60
# Optional Worker monitoring uses the same token. It only lists script names (read-only).
# Add this permission only if an application uses a Cloudflare Worker routing method:
#   Account → Workers Scripts → Read
# The dashboard does not read Worker analytics or tail logs, and it does not deploy Workers.
# To record origin-selection / failover events the Worker itself must POST them.
# Leave WORKER_EVENTS_TOKEN empty to keep that ingest disconnected. The token stays on the server.
WORKER_EVENTS_TOKEN=

# ─── Applications ───────────────────────────────────────────────────────────
# Applications (ICT and any other) are configured in the dashboard — Setup &
# Connections — and stored in PostgreSQL. Nothing about an application lives here.
# DR readiness: DR application response time above this is a WARNING
DR_LATENCY_THRESHOLD_MS=2000

# ─── Hostinger VPS API (optional: plan / CPU / RAM / state import) ───────────
# hPanel → Account → API → Generate token
HOSTINGER_API_TOKEN=
HOSTINGER_SYNC_INTERVAL_SEC=600
HOSTINGER_TIMEOUT_MS=15000

# ─── Email notifications (optional, any SMTP provider) ───────────────────────
# Pick ONE way to name the server:
#   SMTP_SERVICE  nodemailer preset: Gmail, Outlook365, SendGrid, Mailgun, SES, Zoho, Brevo, Postmark, Yahoo, …
#   SMTP_URL      smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (TLS)
#   SMTP_HOST     with SMTP_PORT (587 STARTTLS, 465 TLS, 25 plain relay)
# Examples:
#   Gmail / Google Workspace: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_REQUIRE_TLS=true,
#                             SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password> (needs 2-Step Verification;
#                             never the normal Gmail password), SMTP_FROM=you@gmail.com (or an alias set up in Gmail)
#                             SMTP_SERVICE=Gmail also works: it uses SMTP_PORT when set, else 465 with TLS.
#   Microsoft 365:            SMTP_HOST=smtp.office365.com, SMTP_PORT=587 (SMTP AUTH must be enabled for the mailbox)
#   SendGrid:                 SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASS=<API key>
#   Amazon SES:               SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587, SES SMTP credentials
#   Hostinger mail:           SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465
# SMTP_SECURE: leave empty to decide by port (465 = TLS). 465 with false, or 587 with true, is refused as a config error.
# SMTP_FROM defaults to SMTP_USER when that is an address.
SMTP_SERVICE=
SMTP_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Refuse to send unless STARTTLS succeeds (recommended on port 587)
SMTP_REQUIRE_TLS=false
# Only for an internal relay with a self-signed certificate
SMTP_TLS_REJECT_UNAUTHORIZED=true

# ─── Dead-man heartbeat ──────────────────────────────────────────────────────
# Built in, nothing to set: the heartbeat of the monitored PRD / DR servers, their
# applications, services and databases comes from the agents' reports (freshness:
# TELEMETRY_STALE_THRESHOLD_SEC). No external watchdog is used.
# DEADMAN_HEARTBEAT_URL / DEADMAN_INTERVAL_SEC / DEADMAN_TOLERANCE_SEC are deprecated
# and ignored — remove them from .env.

# ─── Monitoring engine ───────────────────────────────────────────────────────
TELEMETRY_STALE_THRESHOLD_SEC=60
METRICS_RETENTION_HOURS=48
MONITOR_WORKER_CONCURRENCY=10
AUDIT_RETENTION_ENTRIES=5000
# Every check result is kept in DATA_DIR/checks/*.jsonl for availability / SLA
CHECK_HISTORY_RETENTION_DAYS=90
# Agent reports more than this far from server time are rejected (keep NTP on)
AGENT_MAX_CLOCK_SKEW_SEC=300

# ─── Thresholds (applications can override per environment in Setup) ──────────
BACKUP_MAX_AGE_HOURS=26

# ─── Scholario Ops' own database backup (deploy/backup-db.sh, deploy/verify-backup.sh) ─
# Status files are read from here (relative to the app's working directory)
# OPS_BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# Encrypt with a PUBLIC key — the private key never needs to be on this server (pick one):
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_GPG_RECIPIENT=ops-backup@your-domain
# Off-server copy over SSH (e.g. the DR node), checksum-verified on the far side:
# BACKUP_REMOTE=backup@dr-host:/var/backups/scholario-ops
# BACKUP_SSH_KEY=/root/.ssh/scholario_backup
# BACKUP_SSH_PORT=22
# BACKUP_REMOTE_KEEP_DAYS=30
# Restore test target — a SEPARATE scratch database, never the production one:
# BACKUP_VERIFY_DATABASE_URL=postgres://user:password@127.0.0.1:5432/scholario_restore_test
# BACKUP_AGE_IDENTITY=/root/.config/scholario/backup-age-key.txt
REPLICATION_MAX_LAG_SEC=300
SSL_EXPIRY_WARN_DAYS=21
# Minimum minutes between notifications for the same alert
ALERT_COOLDOWN_MIN=15
# Optional: sign WEBHOOK notifications so the receiver can verify they come from Scholario Ops.
# Header X-Scholario-Signature = "sha256=" + HMAC-SHA256(secret, X-Scholario-Timestamp + "." + raw body)
# NOTIFY_WEBHOOK_SECRET=
# Teams / webhook destinations may not be loopback, private, link-local (cloud metadata), CGNAT or
# reserved addresses (SSRF protection, checked when saving and on every send; redirects are not
# followed). Allow specific internal webhook hosts explicitly — hostnames, IPs or CIDRs, comma-separated.
# Link-local / metadata addresses can never be allowed.
# NOTIFY_ALLOWED_PRIVATE_TARGETS=chat.corp.internal,10.20.0.0/16
# Non-critical alerts for one application within this many seconds of the first are sent as one
# summary message (CRITICAL / EMERGENCY are never grouped). 0 = off.
# NOTIFY_GROUP_WINDOW_SEC=60
# Channel targets (webhook URLs, PagerDuty keys, recipients) are encrypted at rest (AES-256-GCM).
# Default key: DATA_DIR/notify-secrets.key, created on first start — back it up together with .env.
# If it goes missing while encrypted targets exist, no new key is created: channel saves are refused
# (HTTP 503) until the backed-up key is restored. See docs/NOTIFICATIONS-OPERATIONS.md.
# To manage the key yourself: 32 bytes as 64 hex characters or base64.
# NOTIFY_SECRETS_KEY=
# How long the notification delivery log is kept
# NOTIFICATION_LOG_RETENTION_DAYS=90
API_RATE_LIMIT_PER_MIN=600

# ─── Logging ────────────────────────────────────────────────────────────────
# debug | info | warn | error. With NODE_ENV=production logs are JSON lines unless LOG_FORMAT=text.
LOG_LEVEL=info
LOG_FORMAT=

# CI pipelines report deployments with: Authorization: Bearer <DEPLOY_REPORT_TOKEN>
DEPLOY_REPORT_TOKEN=

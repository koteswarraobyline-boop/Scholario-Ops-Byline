{
  "name": "scholario-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server/server.ts --dev",
    "build": "vite build && esbuild server/server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.js && node -e \"require('fs').cpSync('server/migrations','dist-server/migrations',{recursive:true})\"",
    "start": "node dist-server/server.js",
    "lint": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.server.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('dist-server',{recursive:true,force:true})\"",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}

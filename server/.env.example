# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://scholario_ops:password@localhost:5432/scholario_ops_dev
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=scholario:

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_long_random_secret_at_least_64_chars
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
SESSION_SECRET=change_me_session_secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ops@scholario.net
SMTP_PASS=change_me_smtp_password
SMTP_FROM="Scholario Ops <ops@scholario.net>"

# ─── Microsoft Teams ───────────────────────────────────────────────────────────
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-teams-webhook-url

# ─── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=change_me_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=change_me_cloudflare_account_id

# ─── Hostinger ─────────────────────────────────────────────────────────────────
HOSTINGER_API_TOKEN=change_me_hostinger_api_token

# ─── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_me_32_char_encryption_key_here

# ─── Monitoring ────────────────────────────────────────────────────────────────
MONITOR_WORKER_CONCURRENCY=5
MONITOR_DEFAULT_INTERVAL_SEC=30
DEAD_MAN_INTERVAL_SEC=15
DEAD_MAN_TOLERANCE_SEC=45
TELEMETRY_STALE_THRESHOLD_SEC=120

# ─── Gemini AI (optional) ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_ENABLED=false
